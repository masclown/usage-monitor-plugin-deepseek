{
  "schemaVersion": 1,
  "minSdkVersion": "0.48.0",
  "providerId": "DeepSeek",
  "displayName": "DeepSeek",
  "meta": {
    "version": "2.0.0",
    "author": "UsageMonitor",
    "description": "Query DeepSeek platform usage (balance / daily cost / requests / tokens)",
    "iconUrl": "https://avatars.githubusercontent.com/u/148330874?s=128&v=4",
    "iconUrlDark": "https://avatars.githubusercontent.com/u/148330874?s=128&v=4"
  },
  "credentialDomains": [ "platform.deepseek.com" ],
  "metadata": {
    "supportedBuckets": [ "day", "week", "month" ],
    "fallbackBucket": "day",
    "supportedTables": [ 1 ],
    "availableSlicerFields": [ "model_name", "channel" ]
  },
  "loginConfig": {
    "loginUrl": "https://platform.deepseek.com/sign_in",
    "cookieDomainFilters": [ "platform.deepseek.com" ],
    "loginTimeout": "00:03:00",
    "uiButtonText": "i18n:plugin.DeepSeek.login.button",
    "validateUrl": "https://platform.deepseek.com/usage",
    "requiredCookieDomain": "platform.deepseek.com",
    "loginUrlKeywords": [ "sign_in", "login", "signin", "sign-in" ],
    "loginSuccessHost": "platform.deepseek.com",
    "loggedInPathKeywords": [ "/usage", "/overview", "/top_up", "/billing" ],
    "localStorageTokens": { "UserToken": "userToken" }
  },
  "configFields": [
    { "key": "ApiKey", "displayName": "i18n:plugin.DeepSeek.field.ApiKey.name", "fieldType": "Password", "isRequired": false, "placeholder": "i18n:plugin.DeepSeek.field.ApiKey.placeholder" }
  ],
  "errorGuidance": [
    { "matchCodes": [ "credential_missing", "config_missing" ], "matchKeywords": [], "message": "i18n:plugin.DeepSeek.guidance.credential" },
    { "matchCodes": [ "auth_invalid" ], "matchKeywords": [ "40002", "Missing Token", "401" ], "message": "i18n:plugin.DeepSeek.guidance.authInvalid" },
    { "matchKeywords": [], "message": "i18n:plugin.DeepSeek.guidance.fallback" }
  ],
  "usageUrls": {
    "zh-CN": "https://platform.deepseek.com/usage"
  },
  "fetch": {
    "endpoints": [
      {
        "urlMatch": "get_user_summary",
        "mode": "http",
        "method": "GET",
        "urlTemplate": "https://platform.deepseek.com/api/v0/users/get_user_summary",
        "headers": {
          "Authorization": "Bearer {config:UserToken}"
        },
        "fields": [
          { "path": "$.data.biz_data.normal_wallets[0].balance", "target": "balance_amount", "transform": "parseNumber" },
          { "path": "$.data.biz_data.bonus_wallets[0].balance", "target": "bonus_balance_amount", "transform": "parseNumber" },
          { "path": "$.data.biz_data.total_available_token_estimation", "target": "available_token_estimation", "transform": "parseNumber" },
          { "path": "$.data.biz_data.monthly_costs[0].amount", "target": "monthly_cost", "transform": "parseNumber" },
          { "path": "$.data.biz_data.total_costs[0].amount", "target": "total_cost", "transform": "parseNumber" },
          { "path": "$.data.biz_data.monthly_token_usage", "target": "monthly_token_usage", "transform": "parseNumber" }
        ]
      },
      {
        "urlMatch": "by_api_key/cost",
        "mode": "http",
        "method": "GET",
        "urlTemplate": "https://platform.deepseek.com/api/v0/usage/by_api_key/cost?start={now:unixDay-30d}&end={now:unixDay}&tz=0",
        "headers": {
          "Authorization": "Bearer {config:UserToken}"
        },
        "arrays": [
          {
            "itemsPath": "$.data.biz_data.data[0].series",
            "mode": "seriesPivot",
            "seriesNameField": "model",
            "nestedItems": "buckets",
            "target": "daily_cost",
            "itemFields": [
              { "path": "$.cost", "target": "request_cost", "transform": "parseNumber", "elementType": "double" }
            ]
          },
          {
            "itemsPath": "$.data.biz_data.data[0].series",
            "mode": "seriesPivot",
            "seriesNameField": "api_key.name",
            "nestedItems": "buckets",
            "target": "channel_cost",
            "itemFields": [
              { "path": "$.cost", "target": "channel_request_cost", "transform": "parseNumber", "elementType": "double" }
            ]
          }
        ]
      },
      {
        "urlMatch": "by_api_key/amount",
        "mode": "http",
        "method": "GET",
        "urlTemplate": "https://platform.deepseek.com/api/v0/usage/by_api_key/amount?start={now:unixDay-30d}&end={now:unixDay}&tz=0",
        "headers": {
          "Authorization": "Bearer {config:UserToken}"
        },
        "arrays": [
          {
            "itemsPath": "$.data.biz_data.series",
            "mode": "seriesPivot",
            "nestedItems": "buckets",
            "target": "daily_requests",
            "itemFields": [
              { "path": "$.usage.REQUEST", "target": "request_count", "transform": "parseNumber", "elementType": "double" }
            ]
          },
          {
            "itemsPath": "$.data.biz_data.series",
            "mode": "seriesPivot",
            "nestedItems": "buckets",
            "target": "daily_tokens",
            "itemFields": [
              { "path": "$.usage.PROMPT_CACHE_MISS_TOKEN", "target": "cache_miss_token", "transform": "parseNumber", "elementType": "double" },
              { "path": "$.usage.PROMPT_CACHE_HIT_TOKEN", "target": "cache_hit_token", "transform": "parseNumber", "elementType": "double" },
              { "path": "$.usage.RESPONSE_TOKEN", "target": "response_token", "transform": "parseNumber", "elementType": "double" }
            ]
          }
        ]
      }
    ],
    "computed": [
      { "target": "subscription_active", "op": "constant", "value": true },
      { "target": "used_tokens", "op": "sumDailyStats", "column": "token_total", "window": "30d" },
      { "target": "window_token_1d", "op": "sumDailyStats", "column": "token_total", "window": "1d" },
      { "target": "window_token_7d", "op": "sumDailyStats", "column": "token_total", "window": "7d" },
      { "target": "window_token_30d", "op": "sumDailyStats", "column": "token_total", "window": "30d" },
      { "target": "monthly_token_usage", "op": "sumDailyStats", "column": "token_total", "window": "monthToDate", "onlyIfAbsent": true },
      { "target": "monthly_request_count", "op": "sumDailyStats", "column": "request_count", "window": "monthToDate" }
    ]
  },
  "card": {
    "renderKinds": ["subscriptionTitle", "summary", "charts"],
    "primaryMetric": "balance_amount",
    "collapseDividerIndex": 6,
    "trayTooltip": {
      "rows": [
        { "fieldName": "__provider_name__" },
        { "fieldName": "balance_amount" },
        { "fieldName": "monthly_cost", "separatorAfter": true }
      ]
    },
    "charts": [
      {
        "chartId": "ds.chart.overview",
        "display": "i18n:plugin.DeepSeek.chart.overview",
        "kind": "Number",
        "defaultOrder": 1,
        "tooltip": {
          "fields": [
            "balance_amount",
            "monthly_cost",
            "total_cost",
            "monthly_token_usage"
          ]
        },
        "dataGroups": [
          { "id": "sdk.template.balanceAmount", "display": "i18n:plugin.DeepSeek.group.balance", "fields": [{ "fieldName": "balance_amount", "role": "Value" }] },
          { "id": "sdk.template.monthlyCost", "display": "i18n:plugin.DeepSeek.group.monthlyCost", "fields": [{ "fieldName": "monthly_cost", "role": "Value" }] },
          { "id": "sdk.template.totalCost", "display": "i18n:plugin.DeepSeek.group.totalCost", "fields": [{ "fieldName": "total_cost", "role": "Value" }] },
          { "id": "sdk.template.monthlyTokenUsage", "display": "i18n:plugin.DeepSeek.group.monthlyToken", "fields": [{ "fieldName": "monthly_token_usage", "role": "Value" }] }
        ]
      },
      {
        "chartId": "ds.chart.dailyCost",
        "display": "i18n:plugin.DeepSeek.chart.dailyCost",
        "kind": "StackedBar",
        "defaultOrder": 2,
        "slicer": {
          "mode": "Period",
          "default": "Last30Days",
          "timeRanges": ["Last7Days", "Last30Days", "Last90Days"]
        },
        "lookbackDays": 30,
        "categoriesField": "daily_cost_categories",
        "seriesNamesField": "daily_cost_series_names",
        "valuesMatrixField": "daily_cost_matrix",
        "unit": "¥",
        "dataGroups": [
          { "id": "sdk.template.dailyCost", "display": "i18n:plugin.DeepSeek.group.dailyCostModel", "fields": [
            { "fieldName": "request_cost", "role": "Value" }
          ] }
        ]
      },
      {
        "chartId": "ds.chart.requestTrend",
        "display": "i18n:plugin.DeepSeek.chart.requestTrend",
        "kind": "Curve",
        "defaultOrder": 5,
        "slicer": {
          "mode": "Period",
          "default": "Last30Days",
          "timeRanges": ["Last7Days", "Last30Days", "Last90Days"]
        },
        "lookbackDays": 30,
        "categoriesField": "daily_requests_categories",
        "seriesNamesField": "daily_requests_series_names",
        "valuesMatrixField": "daily_requests_matrix",
        "unit": "i18n:plugin.DeepSeek.unit.request",
        "colors": ["#4D6BFE"],
        "dataGroups": [
          { "id": "sdk.template.dailyRequestCount", "display": "i18n:plugin.DeepSeek.group.requestCountModel", "fields": [
            { "fieldName": "request_count", "role": "Value" }
          ] }
        ]
      },
      {
        "chartId": "ds.chart.dailyToken",
        "display": "i18n:plugin.DeepSeek.chart.dailyToken",
        "kind": "StackedBar",
        "defaultOrder": 3,
        "slicer": {
          "mode": "Period",
          "default": "Last30Days",
          "timeRanges": ["Last7Days", "Last30Days", "Last90Days"]
        },
        "lookbackDays": 30,
        "categoriesField": "daily_tokens_categories",
        "seriesNamesField": "daily_tokens_series_names",
        "valuesMatrixField": "daily_tokens_matrix",
        "seriesDisplayNames": {
          "cache_miss_token": "i18n:plugin.DeepSeek.series.cacheMiss",
          "cache_hit_token": "i18n:plugin.DeepSeek.series.cacheHit",
          "response_token": "i18n:plugin.DeepSeek.series.response"
        },
        "dataGroups": [
          { "id": "sdk.template.dailyCacheToken", "display": "i18n:plugin.DeepSeek.group.dailyTokenModel", "fields": [
            { "fieldName": "cache_miss_token", "role": "Value" },
            { "fieldName": "cache_hit_token", "role": "Value" },
            { "fieldName": "response_token", "role": "Value" }
          ] }
        ]
      },
      {
        "chartId": "ds.chart.channelCost",
        "display": "i18n:plugin.DeepSeek.chart.channelCost",
        "kind": "StackedBar",
        "defaultOrder": 4,
        "slicer": {
          "mode": "Period",
          "default": "Last30Days",
          "timeRanges": ["Last7Days", "Last30Days", "Last90Days"]
        },
        "lookbackDays": 30,
        "categoriesField": "channel_cost_categories",
        "seriesNamesField": "channel_cost_series_names",
        "valuesMatrixField": "channel_cost_matrix",
        "unit": "¥",
        "dataGroups": [
          { "id": "sdk.template.dailyChannelCost", "display": "i18n:plugin.DeepSeek.group.channelCostChannel", "fields": [
            { "fieldName": "channel_request_cost", "role": "Value" }
          ] }
        ]
      },
      {
        "chartId": "ds.chart.balanceBreakdown",
        "display": "i18n:plugin.DeepSeek.chart.balanceBreakdown",
        "kind": "StackedProgress",
        "defaultOrder": 6,
        "tooltip": {
          "fields": ["balance_amount", "bonus_balance_amount", "available_token_estimation"]
        },
        "dataGroups": [
          { "id": "ds.balance.breakdown", "display": "i18n:plugin.DeepSeek.group.balanceBreakdown", "fields": [
            { "fieldName": "balance_amount", "role": "Value" },
            { "fieldName": "bonus_balance_amount", "role": "Value" },
            { "fieldName": "available_token_estimation", "role": "Upper" }
          ] }
        ]
      },
      {
        "chartId": "ds.chart.balanceTrend",
        "display": "i18n:plugin.DeepSeek.chart.balanceTrend",
        "kind": "Curve",
        "defaultOrder": 7,
        "slicer": {
          "mode": "Period",
          "position": "TopRight",
          "interaction": "Button",
          "timeRanges": ["Last7Days", "Last15Days", "Last30Days"],
          "default": "Last30Days"
        },
        "tooltip": { "fields": ["__date__", "balance_amount"] },
        "dataGroups": [{
          "id": "sdk.template.balanceAmount",
          "fields": [
            { "fieldName": "recorded_at", "role": "Meta" },
            { "fieldName": "balance_amount", "role": "Value" }
          ]
        }]
      },
      {
        "chartId": "ds.chart.monthlyCostTrend",
        "display": "i18n:plugin.DeepSeek.chart.monthlyCostTrend",
        "kind": "Curve",
        "defaultOrder": 8,
        "slicer": {
          "mode": "Period",
          "position": "TopRight",
          "interaction": "Button",
          "timeRanges": ["Last7Days", "Last15Days", "Last30Days"],
          "default": "Last30Days"
        },
        "tooltip": { "fields": ["__date__", "monthly_cost"] },
        "dataGroups": [{
          "id": "sdk.template.monthlyCost",
          "fields": [
            { "fieldName": "recorded_at", "role": "Meta" },
            { "fieldName": "monthly_cost", "role": "Value" }
          ]
        }]
      }
    ]
  },
  "taskbar": {
    "miniCharts": [
      {
        "chartId": "ds.mini.ring",
        "display": "i18n:plugin.DeepSeek.mini.ring",
        "kind": "MiniRingChart",
        "slicer": { "mode": "DataGroup", "interaction": "Scroll", "default": "ds.taskbar.balance" },
        "tooltip": { "fields": ["__provider_name__", "balance_amount", "monthly_cost"] },
        "dataGroups": [
          { "id": "ds.taskbar.balance", "display": "i18n:plugin.DeepSeek.group.taskbarBalance", "fields": [{ "fieldName": "balance_amount", "role": "Value" }] },
          { "id": "ds.taskbar.monthly", "display": "i18n:plugin.DeepSeek.group.taskbarMonthly", "fields": [{ "fieldName": "monthly_cost", "role": "Value" }] }
        ]
      },
      {
        "chartId": "ds.mini.text",
        "display": "i18n:plugin.DeepSeek.mini.text",
        "kind": "MiniText",
        "slicer": { "mode": "DataGroup", "interaction": "Scroll", "default": "ds.taskbar.balance" },
        "tooltip": { "fields": ["__provider_name__", "balance_amount", "monthly_cost"] },
        "dataGroups": [
          { "id": "ds.taskbar.balance", "display": "i18n:plugin.DeepSeek.group.taskbarBalance", "fields": [{ "fieldName": "balance_amount", "role": "Value" }] },
          { "id": "ds.taskbar.monthly", "display": "i18n:plugin.DeepSeek.group.taskbarMonthly", "fields": [{ "fieldName": "monthly_cost", "role": "Value" }] }
        ]
      }
    ]
  }
}
